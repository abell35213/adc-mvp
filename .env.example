# Reference template only.
# Use:
# - backend/.env.example for backend env vars
# - frontend/.env.example for frontend env vars
# - driver-app/.env.example for driver app env vars
# This file exists for quick repo-wide reference and local compose support only.
# ── Backend ──────────────────────────────────────────────────────
# IMPORTANT: replace any "__CHANGE_ME__" value before running anywhere except local dev.
# config.settings.validate_production_invariants() refuses to start in staging/prod
# if the JWT_SECRET_KEY or OTP_HASH_PEPPER still contain the placeholder string.
DATABASE_URL=postgresql://adc_local:adc_local_password@localhost:5432/adc_mvp
POSTGRES_USER=adc_local
POSTGRES_PASSWORD=adc_local_password
POSTGRES_DB=adc_mvp
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=local-dev-jwt-secret-not-for-staging-or-prod
SAMSARA_API_TOKEN=

# ── CORS / Cookies ──────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# ── Vault (filesystem) ──────────────────────────────────────────
STORAGE_BACKEND=fs
VAULT_ROOT=/var/adc/vault

# ── Public URL / Deep-link ───────────────────────────────────────
PUBLIC_APP_BASE_URL=http://localhost:3000
DRIVER_APP_DEEPLINK_SCHEME=adc

# ── Twilio ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=

# ── Driver OTP ───────────────────────────────────────────────────
OTP_HASH_PEPPER=local-dev-otp-pepper-not-for-staging-or-prod
OTP_RESEND_COOLDOWN_SECONDS=60

# ── AWS / S3 (not used in local dev) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=adc-mvp-artifacts
S3_ARTIFACTS_BUCKET=adc-mvp-artifacts
S3_EXPORTS_BUCKET=adc-mvp-exports

# ── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_INTERNAL_BASE_URL=http://localhost:8000

# ── Demo credentials (LOCAL DEV ONLY) ───────────────────────────
# Used by the marketing-site "Try the demo" CTA to prefill the login form
# (frontend/app/login/page.tsx) when ?demo=1 is present. Must match the
# values used by scripts/seed_demo_data.py. Do NOT enable in staging/prod.
NEXT_PUBLIC_DEMO_EMAIL=demo-admin@adc.local
NEXT_PUBLIC_DEMO_PASSWORD=DemoAdmin!2345

# ── Driver App (Expo) ───────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
