# ── Backend ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://adc:adc@localhost:5432/adc_mvp
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
SAMSARA_API_TOKEN=

# ── CORS / Cookies ──────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# ── Vault (filesystem) ──────────────────────────────────────────
VAULT_ROOT=/var/adc/vault

# ── Public URL / Deep-link ───────────────────────────────────────
PUBLIC_APP_BASE_URL=http://localhost:3000
DRIVER_APP_DEEPLINK_SCHEME=adc

# ── Twilio ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=

# ── Driver OTP ───────────────────────────────────────────────────
OTP_HASH_PEPPER=change-me-in-production
OTP_RESEND_COOLDOWN_SECONDS=60

# ── AWS / S3 (not used in local dev) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_ARTIFACTS_BUCKET=adc-mvp-artifacts
S3_EXPORTS_BUCKET=adc-mvp-exports

# ── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Driver App (Expo) ───────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
