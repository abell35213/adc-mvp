APP_ENV=local

SECRET_PROVIDER=env
AWS_SECRETS_MANAGER_SECRET_ID=
AWS_SECRETS_MANAGER_REGION=us-east-1
AWS_SECRETS_MANAGER_VERSION_STAGE=AWSCURRENT

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adc_mvp
REDIS_URL=redis://localhost:6379/0

SAMSARA_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

S3_BUCKET=adc-local-artifacts
S3_ARTIFACTS_BUCKET=adc-local-artifacts
S3_EXPORTS_BUCKET=adc-local-exports

DEBUG=false
LOG_LEVEL=INFO

RELEASE=dev
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
METRICS_BACKEND=inmemory

FRONTEND_ORIGIN=http://localhost:3000
COOKIE_HTTPONLY=true
COOKIE_SECURE=false
COOKIE_DEPLOYMENT_TOPOLOGY=same_site

STORAGE_BACKEND=s3
VAULT_ROOT=/var/adc/vault

PUBLIC_APP_BASE_URL=http://localhost:3000
DRIVER_APP_DEEPLINK_SCHEME=adc

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=

EMAIL_PROVIDER=noop
SES_REGION=us-east-1
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_CONFIGURATION_SET=

CRASH_PACKET_SLA_SECONDS=900

OTP_HASH_PEPPER=change-me
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10
OTP_RATE_LIMIT_WINDOW_SECONDS=300

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EXPORT_DOWNLOAD_URL_EXPIRES_SECONDS=300
ORG_ADMIN_MFA_REQUIRED=false

SOCRATA_APP_TOKEN=
FMCSA_INSPECTIONS_ENABLED=true
FMCSA_INSPECTIONS_REPOLL_ENABLED=true
FMCSA_LOOKBACK_DAYS=360
FMCSA_CACHE_TTL_HOURS=6
FMCSA_INCIDENT_REFRESH_INTERVAL_HOURS=24
FMCSA_BASE_URL=https://data.transportation.gov

AUTH_LOGIN_RATE_LIMIT=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
EXPORT_REQUEST_RATE_LIMIT=20
EXPORT_RATE_LIMIT_WINDOW_SECONDS=300
DRIVER_UPLOAD_URL_RATE_LIMIT=30
DRIVER_UPLOAD_URL_RATE_LIMIT_WINDOW_SECONDS=300
DRIVER_QR_RESOLVE_RATE_LIMIT=60
DRIVER_QR_RESOLVE_RATE_LIMIT_WINDOW_SECONDS=300
