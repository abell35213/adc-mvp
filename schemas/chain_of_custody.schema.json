{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adc.example/schemas/chain_of_custody.schema.json",
  "title": "ADC Chain of Custody Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "incident_id",
    "carrier_id",
    "vehicle",
    "capture_window",
    "source_system",
    "artifacts",
    "data"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "incident_id": { "type": "string", "format": "uuid" },
    "carrier_id": { "type": "string", "minLength": 1 },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adc_vehicle_id", "samsara_vehicle_id"],
      "properties": {
        "adc_vehicle_id": { "type": "string", "minLength": 1 },
        "samsara_vehicle_id": { "type": "string", "minLength": 1 }
      }
    },
    "capture_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_utc", "end_utc", "request_reason"],
      "properties": {
        "start_utc": { "type": "string", "format": "date-time" },
        "end_utc": { "type": "string", "format": "date-time" },
        "request_reason": {
          "type": "string",
          "enum": ["incident_start_default_window", "supplemental_impact_time"]
        }
      }
    },
    "source_system": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "related_artifact_ids"],
      "properties": {
        "artifact_id": { "type": "string", "format": "uuid" },
        "related_artifact_ids": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "custody_time_utc",
              "actor_type",
              "actor_id",
              "action",
              "artifact_id",
              "filename",
              "detail"
            ],
            "properties": {
              "custody_time_utc": { "type": "string", "format": "date-time" },
              "actor_type": {
                "type": "string",
                "enum": [
                  "system",
                  "safety_manager",
                  "driver",
                  "integration",
                  "export_service",
                  "insurer",
                  "counsel"
                ]
              },
              "actor_id": { "type": "string", "minLength": 1 },
              "action": {
                "type": "string",
                "enum": [
                  "captured",
                  "stored",
                  "hashed",
                  "accessed",
                  "downloaded",
                  "export_generated",
                  "export_downloaded"
                ]
              },
              "artifact_id": { "type": ["string", "null"], "format": "uuid" },
              "filename": { "type": ["string", "null"], "minLength": 1 },
              "detail": { "type": "string", "maxLength": 240 }
            }
          }
        }
      }
    }
  }
}