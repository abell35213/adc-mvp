{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adc.example/schemas/safety_events.schema.json",
  "title": "ADC Safety Events Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "incident_id",
    "carrier_id",
    "vehicle",
    "capture_window",
    "source_system",
    "artifacts",
    "data"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "incident_id": { "type": "string", "format": "uuid" },
    "carrier_id": { "type": "string", "minLength": 1 },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adc_vehicle_id", "samsara_vehicle_id"],
      "properties": {
        "adc_vehicle_id": { "type": "string", "minLength": 1 },
        "samsara_vehicle_id": { "type": "string", "minLength": 1 }
      }
    },
    "capture_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_utc", "end_utc", "request_reason"],
      "properties": {
        "start_utc": { "type": "string", "format": "date-time" },
        "end_utc": { "type": "string", "format": "date-time" },
        "request_reason": {
          "type": "string",
          "enum": ["incident_start_default_window", "supplemental_impact_time"]
        }
      }
    },
    "source_system": { "type": "string", "const": "samsara" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "related_artifact_ids"],
      "properties": {
        "artifact_id": { "type": "string", "format": "uuid" },
        "related_artifact_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "summary"],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "event_time_utc",
              "event_type",
              "severity",
              "value",
              "location",
              "source"
            ],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "event_time_utc": { "type": "string", "format": "date-time" },
              "event_type": {
                "type": "string",
                "enum": [
                  "hard_brake",
                  "harsh_accel",
                  "harsh_turn",
                  "speeding",
                  "collision_detected",
                  "unknown"
                ]
              },
              "severity": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": ["metric", "amount"],
                "properties": {
                  "metric": { "type": "string", "enum": ["mph_over_limit", "g_force", "mph", "unknown"] },
                  "amount": { "type": "number" }
                }
              },
              "location": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lat", "lon", "source"],
                "properties": {
                  "lat": { "type": "number" },
                  "lon": { "type": "number" },
                  "source": { "type": "string", "enum": ["gps", "unknown"] }
                }
              },
              "source": { "type": "string", "const": "samsara_safety" }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events_count", "events_by_type"],
          "properties": {
            "events_count": { "type": "integer", "minimum": 0 },
            "events_by_type": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hard_brake",
                "harsh_accel",
                "harsh_turn",
                "speeding",
                "collision_detected",
                "unknown"
              ],
              "properties": {
                "hard_brake": { "type": "integer", "minimum": 0 },
                "harsh_accel": { "type": "integer", "minimum": 0 },
                "harsh_turn": { "type": "integer", "minimum": 0 },
                "speeding": { "type": "integer", "minimum": 0 },
                "collision_detected": { "type": "integer", "minimum": 0 },
                "unknown": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}